{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "sh scripts/vercel-install.sh",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "notes.jasonsooter.com"
        }
      ],
      "destination": "https://www.jasonsooter.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/page/:page",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/tags/:tag/feed.xml",
      "destination": "/tags/:tag",
      "permanent": true
    },
    {
      "source": "/blog/rendering-reference",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/2021-Fort-Collins-Intersection-Counts",
      "destination": "/blog/2021-fort-collins-intersection-counts",
      "permanent": true
    },
    {
      "source": "/first-major-mountain-bike-ride",
      "destination": "/blog/first-major-mountain-bike-ride",
      "permanent": true
    },
    {
      "source": "/improving-my-git-hygiene-with-patch",
      "destination": "/blog/improving-my-git-hygiene-with-patch",
      "permanent": true
    },
    {
      "source": "/jwt-learnings",
      "destination": "/blog/jwt-learnings",
      "permanent": true
    },
    {
      "source": "/the-sweet-smell-of-success",
      "destination": "/blog/the-sweet-smell-of-success",
      "permanent": true
    },
    {
      "source": "/you-are-the-local-source-for-gratitude-reminders",
      "destination": "/blog/you-are-the-local-source-for-gratitude-reminders",
      "permanent": true
    },
    {
      "source": "/urban-planning/trains",
      "destination": "/infrastructure/trains",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
